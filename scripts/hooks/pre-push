#!/bin/sh
# Before a push: refuse pushing to main directly (open a pull request instead), then run the
# typecheck and tests so broken code never leaves this machine.
# Turn on once per clone with: pnpm hooks:install   (skip once with: git push --no-verify)

zero=0000000000000000000000000000000000000000
check=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: not pushing to ${remote_ref#refs/heads/} directly." >&2
      echo "  Push a branch and open a pull request (gh pr merge --auto --merge merges it once CI passes)." >&2
      exit 1
      ;;
  esac
  # Deleting a remote branch needs no checks.
  [ "$local_sha" = "$zero" ] || check=1
done

[ "$check" = 1 ] || exit 0

echo "pre-push: running pnpm check (typecheck + tests)..." >&2
if ! pnpm check >/dev/null 2>&1; then
  echo "pre-push: pnpm check failed. Run 'pnpm check' to see why, fix it, then push again." >&2
  exit 1
fi
echo "pre-push: checks passed." >&2
